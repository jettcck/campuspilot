# ===== 服务配置 =====
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# ===== 数据库 =====
# 留空则使用本地文件存储（server/data/db.json），便于零依赖演示
# 生产环境建议填写 MongoDB Atlas 连接串
MONGODB_URI=

# ===== 身份认证 =====
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=7d

# ===== AI 能力（OpenAI 兼容协议）=====
# 留空 AI_API_KEY 时项目自动使用内置规则引擎，不影响功能演示
# AI_PROVIDER 可选：deepseek / qwen / zhipu / moonshot / openai / ollama
# 切换厂商只需改 AI_PROVIDER 一行，baseUrl 与 model 会自动套用预设
#   deepseek https://platform.deepseek.com/api_keys
#   qwen     https://bailian.console.aliyun.com/
AI_PROVIDER=deepseek
AI_API_KEY=
# 以下两项可选：留空使用预设值，需要自定义网关时再填
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# ===== 文件上传 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760