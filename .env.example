# ===== 服务配置 =====
NODE_ENV=development
PORT=3001
# 允许跨域的来源，多个用逗号分隔；生产环境不填则只放行站点自身域名
CLIENT_URL=http://localhost:5173
# 部署在反向代理（Render / Nginx）之后需置为 true，限流才能按真实客户端 IP 统计
TRUST_PROXY=false
# 日志级别：debug / info / warn / error
LOG_LEVEL=debug

# ===== 数据库 =====
# 留空则使用本地文件存储（server/data/db.json），便于零依赖本地开发
# 生产环境必须填写 MongoDB 连接串；如确认使用临时文件存储，需显式设置 ALLOW_FILE_STORAGE=true
MONGODB_URI=
# ALLOW_FILE_STORAGE=false
# 本地文件存储的数据目录（测试或多实例隔离时可指向临时目录）
# DATA_DIR=./server/data

# ===== 身份认证 =====
# 生产环境必须配置且长度不少于 32 位，否则服务拒绝启动
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=7d

# ===== 接口限流 =====
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_API_MAX=600      # 单来源窗口内总请求数
# RATE_LIMIT_AUTH_MAX=10      # 登录/注册失败次数上限（防暴力破解）
# RATE_LIMIT_AI_MAX=30        # AI 接口次数上限（控制大模型成本）

# ===== AI 能力（OpenAI 兼容协议）=====
# 留空 AI_API_KEY 时项目自动使用内置规则引擎，功能链路依旧完整
# AI_PROVIDER 可选：deepseek / qwen / zhipu / moonshot / openai / ollama
# 切换厂商只需改 AI_PROVIDER 一行，baseUrl 与 model 会自动套用预设
#   deepseek https://platform.deepseek.com/api_keys
#   qwen     https://bailian.console.aliyun.com/
AI_PROVIDER=deepseek
AI_API_KEY=
# 以下两项可选：留空使用预设值，需要自定义网关时再填
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# ===== 文件上传 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760